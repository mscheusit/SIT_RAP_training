projection implementation in class zbp_sitc_c_mm_article unique;
strict ( 2 );
use side effects;

define behavior for ZSITC_C_MM_Article alias Article
use etag

{
  use create;
  use update;
  use delete;

  use action release;

  use association _Text { create; }
  use association _Supplier { create; }
}

define behavior for ZSITC_C_MM_Article_Text alias ArticleText
use etag
{
  use update;
  use delete;

  use association _Article;
}

define behavior for ZSITC_C_MM_Article_Supplier alias ArticleSupplier
use etag
{
  use update;
  use delete;

  use association _Article;
}