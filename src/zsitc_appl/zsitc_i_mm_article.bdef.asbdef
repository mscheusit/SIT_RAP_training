managed implementation in class zbp_sitc_i_mm_article unique;
strict ( 2 );

define behavior for ZSITC_I_MM_Article alias Article
persistent table zsitc_mm_article
with additional save
etag master LastChangedAt
lock master
early numbering
authorization master ( instance )
{
  create ( authorization : global );
  update ( features : instance );
  delete;

  field ( readonly ) ArticleID, Released, ReleasedDate, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;
  field ( mandatory ) ArticleNo;

  //field (features : instance ) ArticleNo, ArticleType, RegularVendor ;

  association _Text { create ( features : instance ); }
  association _Supplier { create ( features : instance ); }

  validation validateArticleNo on save { field ArticleNo; }

  action ( features : instance ) release parameter zsitc_A_mm_release_parameter result [1] $self;

  side effects
  {
    // if field ArticleNo is changed (Trigger),
    field ArticleNo
    // target field.
    affects field LastChangedAt;
  }

  mapping for zsitc_mm_article
    {
      ArticleID     = artid;
      ArticleNo     = artnr;
      ArticleType   = arttp;
      RegularVendor = rlifn;
      Released      = released;
      ReleasedDate  = released_date;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZSITC_I_MM_Article_Text alias ArticleText
persistent table zsitc_mm_articlt
etag master LastChangedAt
lock dependent by _Article
early numbering
authorization dependent by _Article
{
  update ( features : instance );
  delete ( features : instance );

  // static field control
  field ( readonly ) ArticleID, LastChangedBy, LastChangedAt;

  field ( mandatory : create, readonly : update ) Language;

  association _Article;

  mapping for zsitc_mm_articlt
    {
      ArticleID     = artid;
      Language      = spras;
      Description   = bezei;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZSITC_I_MM_Article_Supplier alias ArticleSupplier
persistent table zsitc_mm_articll
etag master LastChangedAt
lock dependent by _Article
early numbering
authorization dependent by _Article
{
  update ( features : instance );
  delete ( features : instance );

  // static field control
  field ( readonly ) ArticleID, LastChangedBy, LastChangedAt;

  field ( mandatory : create, readonly : update ) Supplier;

  association _Article;

  mapping for zsitc_mm_articll
    {
      ArticleID     = artid;
      Supplier      = lifnr;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}