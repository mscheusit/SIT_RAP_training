<mvc:View
controllerName="zsitc.articler.controller.SupplierList"
xmlns="sap.m"
xmlns:mvc="sap.ui.core.mvc">
    <Panel accessibleRole="Region">
    <headerToolbar>
        <Toolbar>
            <Title text="{i18n>invoiceListTitle}"/>
            <ToolbarSpacer/>
            <SearchField
                width="50%"
                search=".onFilterInvoices"
                ariaLabelledBy="searchFieldLabel"
                ariaDescribedBy="searchFieldDescription"
                placeholder="{i18n>searchFieldPlaceHolder}"/>
        </Toolbar>
    </headerToolbar>
    <Table
        id="invoiceList"
        class="saUiResponsiveMargin"
        width="auto"
        items="{
            path: '/ArticleSupplier',
            sorter: {
                path: 'ShipperName',
                group: true
                }
            }">
        <columns>
            <Column 
                minScreenWidth="Tablet"
                demandPopin="false">
                <Text text="{i18n>columnSupplier}"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem
                type="Navigation"
                press=".onPress">
                <cells>
                    <Text text="{Supplier}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
    </Panel>
</mvc:View>