<mvc:View
controllerName="zsitc.articler.controller.SupplierList"
xmlns="sap.m"
xmlns:mvc="sap.ui.core.mvc">
<Page id="_IDGenPage">
    <Panel id="_IDGenPanel" accessibleRole="Region">    
    <Table
        id="invoiceList"
        class="saUiResponsiveMargin"
        width="auto"
        items="{
            path: '/ArticleSupplier',
            sorter: {
                path: 'ShipperName',
                group: true
                }
            }">
        <columns>
            <Column id="_IDGenColumn" 
                minScreenWidth="Tablet"
                demandPopin="false">
                <Text id="_IDGenText" text="{i18n>columnSupplier}"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem id="_IDGenColumnListItem"
                type="Navigation"
                press=".onPress">
                <cells>
                    <Text id="_IDGenText1" text="{Supplier}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
    </Panel>
    </Page>
</mvc:View>