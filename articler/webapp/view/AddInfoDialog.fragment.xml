<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="addInfoDialog"
        title="{i18n>dialogArticleText} {ArticleNo}">
        <content>
            <core:Icon
                src="sap-icon://hello-world"
                size="8rem"
                class="sapUiMediumMargin"/>
            <FormattedText htmlText="{ArticleType}"/>
        </content>
        <beginButton>
            <Button
                text="{i18n>dialogCloseButtonText}"
                press="onCloseDialog"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>