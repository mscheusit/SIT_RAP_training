<mvc:View
controllerName="zsitc.articler.SupplierList.controller.SupplierList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc">
	<Page title="xxxxxxx"></Page>
	<ObjectHeader
			intro="{ArticleID}"
			title="{ArticleNo}"/>
	 <Table
        id="supplierList"
        class="saUiResponsiveMargin"
        width="auto"
        items="{ path: 'to_Text' }">
        <columns>
            <Column>
                <Text text="Language"/>
            </Column>
            <Column>
                <Text text="Description"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{Language}"/>
                </cells>
                <cells>
                    <Text text="{Description}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>		
</mvc:View>